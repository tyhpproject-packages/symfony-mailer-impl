{
    "name": "tyhpdef/symfony-mailer-impl",
    "description": "Implementation package for tyhpdef/symfony-mailer. Require tyhpdef/symfony-mailer, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.4.19.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-mime": "@dev",
                "tyhpdef/psr-event-dispatcher": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/symfony-event-dispatcher": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/egulias-email-validator": "@dev",
                "tyhpdef/symfony-http-client-contracts": "@dev",
                "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/doctrine-lexer": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/symfony-mailer"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/mailer": "7.4.19"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-mime": "@dev",
        "tyhpdef/psr-event-dispatcher": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/symfony-event-dispatcher": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/egulias-email-validator": "@dev",
        "tyhpdef/symfony-http-client-contracts": "@dev",
        "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/doctrine-lexer": "@dev"
    }
}
